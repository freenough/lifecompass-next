{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/verify-fixtures.js",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "allow": [
    "Bash(node scripts/*)",
    "Bash(npm run *)",
    "Bash(npm test*)",
    "Bash(git diff*)",
    "Bash(git status*)",
    "Bash(git add*)",
    "Bash(git commit*)",
    "Bash(git log*)"
  ]
}